# ---------------------------------------
# CORE RUNTIME
# ---------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/mealkhata
APP_TIMEZONE=Asia/Kolkata
AUTH_JWT_SECRET=<generate-a-strong-secret>
APP_ORIGIN=http://localhost:5173

# ---------------------------------------
# OPTIONAL WEB PUSH
# ---------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------
# USER ACCOUNT MIGRATION ONLY
# Not required by normal application runtime.
# ---------------------------------------
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD_HASH=
# MEMBER_GAURAV_EMAIL=
# MEMBER_GAURAV_PASSWORD_HASH=
# MEMBER_NIKHIL_EMAIL=
# MEMBER_NIKHIL_PASSWORD_HASH=
# MEMBER_DEVANSH_EMAIL=
# MEMBER_DEVANSH_PASSWORD_HASH=

# ---------------------------------------
# BACKUP / RESTORE CLI ONLY
# ---------------------------------------
# BACKUP_ENCRYPTION_KEY=
# RESTORE_MONGODB_URI=
