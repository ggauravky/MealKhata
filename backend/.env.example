NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/mealkhata
APP_TIMEZONE=Asia/Kolkata
ADMIN_EMAIL=admin@mealkhata.local
ADMIN_PASSWORD_HASH=
SUPERADMIN_EMAIL=superadmin@mealkhata.local
SUPERADMIN_PASSWORD_HASH=
AUTH_JWT_SECRET=
APP_ORIGIN=http://localhost:5173

# Member Account Bootstrap / Seeding Variables (used by 'npm run seed-members')
MEMBER_GAURAV_EMAIL=gaurav@mealkhata.local
MEMBER_GAURAV_PASSWORD_HASH=
MEMBER_NIKHIL_EMAIL=nikhil@mealkhata.local
MEMBER_NIKHIL_PASSWORD_HASH=
MEMBER_DEVANSH_EMAIL=devansh@mealkhata.local
MEMBER_DEVANSH_PASSWORD_HASH=

# Optional: Only required for background Web Push reminders (Phase 9)
# If omitted, MealKhata core operates normally with in-app reminders.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

