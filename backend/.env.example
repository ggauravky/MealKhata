# ---------------------------------------
# CORE RUNTIME
# ---------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/mealkhata
APP_TIMEZONE=Asia/Kolkata
# At least 48 random bytes in production, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=<generate-a-strong-secret>
APP_ORIGIN=http://localhost:5173
# Optional maximum physical plates per meal, integer 1-100.
# Default scales with the saved participant count (minimum 3, maximum 100).
# MEAL_MAX_PHYSICAL_PLATES=8

# ---------------------------------------
# OPTIONAL WEB PUSH
# ---------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------
# BACKUP / RESTORE CLI ONLY
# ---------------------------------------
# BACKUP_ENCRYPTION_KEY=
# RESTORE_MONGODB_URI=
# RESTORE_TARGET_CLASSIFICATION=isolated-test
