{
  "name": "mealkhata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private meal and shared-bill tracker for three roommates.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,backend --prefix-colors cyan,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "lint": "eslint frontend/src frontend/test frontend/vite.config.js backend/src backend/scripts backend/test eslint.config.js",
    "test": "npm run test --workspaces --if-present",
    "hash-password": "npm run hash-password --workspace backend",
    "migrate:user-accounts": "npm run migrate:user-accounts --workspace backend",
    "seed-members": "npm run seed-members --workspace backend",
    "generate-vapid-keys": "npm run generate-vapid-keys --workspace backend",
    "send-push-reminders": "npm run send-push-reminders --workspace backend",
    "verify-production-build": "npm run verify-production-build --workspace backend",
    "security:check": "npm run security:check --workspace backend",
    "verify-indexes": "npm run verify-indexes --workspace backend",
    "verify-data": "npm run verify-data --workspace backend",
    "db:backup": "npm run db:backup --workspace backend",
    "db:backup:verify": "npm run db:backup:verify --workspace backend",
    "db:restore": "npm run db:restore --workspace backend",
    "db:clear-sample": "npm run db:clear-sample --workspace backend",
    "db:clear-pre-october": "npm run db:clear-pre-october --workspace backend",
    "perf:check": "npm run perf:check --workspace backend",
    "release:check": "npm run release:check --workspace backend",
    "release:smoke": "npm run release:smoke --workspace backend"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
